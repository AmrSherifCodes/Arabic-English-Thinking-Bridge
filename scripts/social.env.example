# Copy to .env.social in repo root (already gitignored by .env*) and fill in only the platforms you want to auto-post via CLI.
# Usage:
#   npm run social:dry
#   npm run social:post

# X (Twitter) v2 OAuth 2.0 User Access Token (tweet.write)
SOCIAL_X_ACCESS_TOKEN=

# LinkedIn REST Posts API (w_member_social token + person/org URN e.g. urn:li:person:XXXX)
SOCIAL_LINKEDIN_ACCESS_TOKEN=
SOCIAL_LINKEDIN_AUTHOR_URN=

# Facebook Page Graph API v21.0
SOCIAL_FB_PAGE_ID=
SOCIAL_FB_ACCESS_TOKEN=

# Telegram Bot API (bot token + @channel or numeric chat ID)
SOCIAL_TELEGRAM_BOT_TOKEN=
SOCIAL_TELEGRAM_CHAT_ID=

# Discord Webhook URL
SOCIAL_DISCORD_WEBHOOK_URL=

# Bluesky ATProto (handle + app password from bsky.app/settings/app-passwords)
SOCIAL_BSKY_HANDLE=
SOCIAL_BSKY_APP_PASSWORD=

# Mastodon (instance URL e.g. https://mastodon.social + access token)
SOCIAL_MASTODON_INSTANCE=
SOCIAL_MASTODON_TOKEN=

# Reddit OAuth (Bearer token + target subreddit name without r/)
SOCIAL_REDDIT_ACCESS_TOKEN=
SOCIAL_REDDIT_SUBREDDIT=
