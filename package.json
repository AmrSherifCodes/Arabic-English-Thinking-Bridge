  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:live": "node scripts/live-reload.js on",
    "live:off": "node scripts/live-reload.js off",
    "live:status": "node scripts/live-reload.js status",
    "build": "vite build",
    "build:android": "cross-env CAPACITOR_BUILD=true vite build",
    "build:android:win": "set CAPACITOR_BUILD=true && vite build",
    "preview": "vite preview",
    "test": "tsx --test src/**/*.test.ts src/**/*.test.tsx scripts/verify-all-languages.mjs api/*.test.js",
