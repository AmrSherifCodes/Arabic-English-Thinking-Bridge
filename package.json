    "generate:dictionary": "node generate-dictionary.js",
    "build:dictionary": "node build-dictionary-from-sources.js",
    "clean:dictionary": "node clean-dictionary.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "e2e": "playwright test",
    "vercel:env": "node scripts/setup-vercel-env.mjs",
    "dev:windows": "tauri dev",
    "build:windows": "tauri build"
  },
