{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thinking English",
  "version": "3.1.0",
  "identifier": "com.amrsherif.thinkingenglish",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "فكّر إنجليزي | Thinking English",
        "width": 1000,
        "height": 800,
        "minWidth": 375,
        "minHeight": 667,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}