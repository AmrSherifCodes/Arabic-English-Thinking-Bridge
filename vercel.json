{
  "redirects": [
    {
      "source": "/apk",
      "destination": "https://github.com/AmrSherifCodes/Arabic-English-Thinking-Bridge/releases/download/v3.0.3/Thinking-Bridge-v3.0.3.apk",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "https://github.com/AmrSherifCodes/Arabic-English-Thinking-Bridge/releases/download/v3.0.3/Thinking-Bridge-v3.0.3.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*|assets/.*|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/gemini",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' capacitor: http://localhost; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' capacitor: http://localhost https://*.vercel.app https://arabicenglishthinkingbridge.vercel.app https://api.mymemory.translated.net https://*.supabase.co https://*.upstash.io wss://*.supabase.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
        }
      ]
    }
  ]
}
