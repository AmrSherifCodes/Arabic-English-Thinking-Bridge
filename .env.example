# Vercel Serverless Discord Webhooks (Production)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_FEEDBACK_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_FEEDBACK_WEBHOOK=https://discord.com/api/webhooks/YOUR_FEEDBACK_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_REVIEWS_WEBHOOK=https://discord.com/api/webhooks/YOUR_REVIEWS_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Vercel CLI Token for Automated Setup Script (npm run vercel:env)
# Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_access_token_here

# Client API Base URL
VITE_API_BASE=https://tb-eg.vercel.app
