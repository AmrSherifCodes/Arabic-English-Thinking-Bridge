# Server-only Gemini API key. Never add a VITE_ prefix to this secret.
# Configure it in your local server environment and deployment provider's secrets.
GEMINI_API_KEY="replace-with-a-server-side-key"
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public Supabase client configuration. Never use a service_role key here.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_ADMIN_EMAIL="admin@example.com"
