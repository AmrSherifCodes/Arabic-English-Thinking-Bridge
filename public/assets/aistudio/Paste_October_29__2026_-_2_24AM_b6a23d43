          fbTitle.innerHTML = `<span>✅ Correct! (+${earnedPoints} XP)</span>`;
          fbEn.textContent = diag.en;
          fbAr.textContent = diag.ar;

          populateRevealBreakdown(ex);
          speakEnglish(ex.target, 1.0);
        } else {
          // Wrong answer: beep(false), remove .shake, force reflow, re-add .shake, show diagnosis
          beep(false, state.soundOn);
          currentRetryCount += 1;
          state.streak = 0;

          if (diag.tag) {
