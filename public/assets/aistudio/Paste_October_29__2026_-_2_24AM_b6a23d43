      // ------------------------- PRONUNCIATION PRACTICE -------------------------
      let activeMediaRecorder = null;
      let recordedChunks = [];

      function startPronunciationCheck() {
        const lesson = LESSONS[currentLessonIndex];
        const ex = lesson.exercises[currentExerciseIndex];
        const resultBox = document.getElementById('pron-result-box');
        const labelEl = document.getElementById('pron-record-label');
        const SR = window.SpeechRecognition || window.webkitSpeechRecognition;

        // Start MediaRecorder for self-playback if available
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
          navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
            recordedChunks = [];
            activeMediaRecorder = new MediaRecorder(stream);
            activeMediaRecorder.ondataavailable = e => {
              if (e.data && e.data.size > 0) recordedChunks.push(e.data);
            };
            activeMediaRecorder.onstop = () => {
              const blob = new Blob(recordedChunks, { type: 'audio/webm' });
              if (selfPronAudioUrl) URL.revokeObjectURL(selfPronAudioUrl);
              selfPronAudioUrl = URL.createObjectURL(blob);
              document.getElementById('pron-play-self-btn').classList.remove('hidden');
              stream.getTracks().forEach(t => t.stop());
            };
            activeMediaRecorder.start();
            setTimeout(() => {
              if (activeMediaRecorder && activeMediaRecorder.state === 'recording') {
                activeMediaRecorder.stop();
              }
            }, 4500);
          }).catch(() => {});
        }

        if (!SR) {
          resultBox.classList.remove('hidden');
          resultBox.innerHTML = `<p class="text-amber-600 dark:text-amber-400 font-semibold">SpeechRecognition is not supported in this mobile browser. Your voice is still being recorded for self-comparison—tap “My Recording” and compare with “Hear”!</p>`;
          return;
        }

        try {
          const rec = new SR();
          rec.lang = 'en-US';
          rec.interimResults = false;
          rec.maxAlternatives = 1;
          labelEl.textContent = 'Listening… Speak now';

          rec.onresult = (event) => {
            const transcript = event.results[0][0].transcript || '';
            const normSpoken = normalizeSentence(transcript).split(' ');
            const normTarget = normalizeSentence(ex.target).split(' ');
            const targetWordsRaw = ex.target.split(' ');

            let matched = 0;
            const diffHtml = targetWordsRaw.map((w, i) => {
              const cleanW = normalizeSentence(w);
              const ok = normSpoken.includes(cleanW);
              if (ok) matched++;
              return `<span class="px-1.5 py-0.5 rounded font-bold ${ok ? 'bg-emerald-500/20 text-emerald-600 dark:text-emerald-400' : 'bg-rose-500/20 text-rose-600 dark:text-rose-400'}">${w}</span>`;
            }).join(' ');

            const acc = Math.round((matched / normTarget.length) * 100);
            resultBox.classList.remove('hidden');
            resultBox.innerHTML = `
              <div class="font-bold">You said: <span class="text-emerald-600 dark:text-emerald-400">“${transcript}”</span> (${acc}% match)</div>
              <div class="flex flex-wrap gap-1 pt-1">${diffHtml}</div>
            `;
            if (activeMediaRecorder && activeMediaRecorder.state === 'recording') {
              activeMediaRecorder.stop();
            }
          };

          rec.onerror = () => {
            labelEl.textContent = 'Hold / Tap to Speak';
            resultBox.classList.remove('hidden');
            resultBox.innerHTML = `<p class="text-amber-600 dark:text-amber-400">Could not transcribe audio clearly. Try speaking closer to the microphone or use the self-recording button.</p>`;
          };

          rec.onend = () => {
            labelEl.textContent = 'Hold / Tap to Speak';
          };

          rec.start();
        } catch (err) {
          labelEl.textContent = 'Hold / Tap to Speak';
        }
      }

      // ------------------------- RENDER TAB 3: TEACHER HUB -------------------------
      function renderTeacherTab() {
        const listEl = document.getElementById('student-questions-list');
        listEl.innerHTML = '';

        state.mentorQuestions.forEach(q => {
          const item = document.createElement('div');
          item.className = 'p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-2 text-xs';

          const header = document.createElement('div');
          header.className = 'flex items-center justify-between font-bold text-slate-700 dark:text-slate-300';
          const nameSpan = document.createElement('span');
          nameSpan.textContent = `👤 ${q.student || 'Student'}`;
          const timeSpan = document.createElement('span');
          timeSpan.className = 'text-[11px] text-slate-400';
          timeSpan.textContent = q.createdAt || 'Just now';
          header.appendChild(nameSpan);
          header.appendChild(timeSpan);
          item.appendChild(header);

          const qText = document.createElement('p');
          qText.className = 'text-slate-800 dark:text-slate-200 font-medium';
          qText.textContent = q.question;
          item.appendChild(qText);

          if (q.audioDataUrl) {
            const aud = document.createElement('audio');
            aud.controls = true;
            aud.src = q.audioDataUrl;
            aud.className = 'h-8 w-full max-w-xs';
            item.appendChild(aud);
          }

          if (q.reply) {
            const rep = document.createElement('div');
            rep.className = 'p-2.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-900 dark:text-emerald-200 font-medium';
            rep.textContent = `🎓 Mentor Reply: ${q.reply}`;
            item.appendChild(rep);
          } else {
            const pending = document.createElement('div');
            pending.className = 'text-[11px] text-amber-600 dark:text-amber-400 font-semibold';
            pending.textContent = '⏳ Awaiting instructor reply…';
            item.appendChild(pending);
          }

          listEl.appendChild(item);
        });

        if (teacherUnlocked) {
          renderTeacherUnlockedConsole();
        }
      }

      function renderTeacherUnlockedConsole() {
        const panel = document.getElementById('teacher-unlocked-panel');
        panel.classList.remove('hidden');

        // Most-missed stats
        const statsEl = document.getElementById('teacher-weakspots-stats');
        const entries = Object.entries(state.weakSpots || {}).sort((a, b) => b[1] - a[1]);
        if (!entries.length) {
          statsEl.innerHTML = `<p class="text-slate-500">No missed interference patterns logged yet. Default diagnostic focus: <strong>Copula dropping (حذف فعل الكينونة)</strong>.</p>`;
        } else {
          statsEl.innerHTML = entries.map(([tag, count], idx) =>
            `<div class="flex items-center justify-between py-1 border-b border-slate-200/60 dark:border-slate-800">
              <span class="font-semibold">${idx + 1}. ${tag}</span>
              <span class="px-2 py-0.5 rounded bg-rose-500/15 text-rose-500 font-bold">${count} misses</span>
            </div>`
          ).join('');
        }

        // Reply queue
        const queueEl = document.getElementById('teacher-reply-queue');
        queueEl.innerHTML = '';
        state.mentorQuestions.forEach((q, idx) => {
          const row = document.createElement('div');
          row.className = 'p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-2 text-xs';
          const title = document.createElement('div');
          title.className = 'font-bold';
          title.textContent = `${q.student}: “${q.question}”`;
          row.appendChild(title);

          const inputWrap = document.createElement('div');
          inputWrap.className = 'flex gap-2';
          const inp = document.createElement('input');
          inp.type = 'text';
          inp.value = q.reply || '';
          inp.placeholder = 'Write mentor response…';
          inp.className = 'flex-1 px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700';

          const saveBtn = document.createElement('button');
          saveBtn.className = 'px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-bold';
          saveBtn.textContent = 'Save Reply';
          saveBtn.addEventListener('click', () => {
            state.mentorQuestions[idx].reply = inp.value.trim();
            StorageVault.save(state);
            renderTeacherTab();
            showToast('Mentor reply saved!', 'emerald');
          });

          inputWrap.appendChild(inp);
          inputWrap.appendChild(saveBtn);
          row.appendChild(inputWrap);
          queueEl.appendChild(row);
        });
      }

      // ------------------------- RENDER TAB 4: PROGRESS -------------------------
      function renderProgressTab() {
        const lvl = computeLevel(state.score);
        const lvlName = LEVEL_NAMES[lvl];
        const intoLevel = state.score % 60;
        const pct = lvl === 4 ? 100 : Math.min(100, Math.round((intoLevel / 60) * 100));

        document.getElementById('prog-level-num').textContent = `L${lvl + 1}`;
        document.getElementById('prog-level-title').textContent = lvlName;
        document.getElementById('prog-level-xp').textContent =
          lvl === 4 ? `${state.score} XP · Max Rank Achieved!` : `${state.score} XP Total · ${60 - intoLevel} XP to ${LEVEL_NAMES[lvl + 1]}`;
        document.getElementById('prog-level-bar').style.width = `${pct}%`;

        // Sound toggle UI
        document.getElementById('sound-toggle-icon').textContent = state.soundOn ? '🔊' : '🔇';
        document.getElementById('sound-toggle-text').textContent = `Sound Effects: ${state.soundOn ? 'ON' : 'OFF'}`;

        // Phase completion bars
        const phaseBars = document.getElementById('prog-phase-bars');
        phaseBars.innerHTML = '';
        [1, 2, 3].forEach(pNum => {
          const pLessons = LESSONS.filter(l => l.phase === pNum);
          const done = pLessons.filter(l => state.completedLessonIds.includes(l.id)).length;
          const pPct = Math.round((done / pLessons.length) * 100);
          const div = document.createElement('div');
          div.className = 'p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-1.5';
          div.innerHTML = `
            <div class="flex justify-between text-xs font-bold">
              <span>Phase ${pNum}</span>
              <span class="text-emerald-600 dark:text-emerald-400">${pPct}% (${done}/${pLessons.length})</span>
            </div>
            <div class="w-full h-2 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-emerald-500" style="width:${pPct}%"></div>
            </div>
          `;
          phaseBars.appendChild(div);
        });

        // Badges Grid (First win, 5 in a row, 10 in a row, Phase 1 done, All lessons done, Asked the mentor)
        const p1Ids = LESSONS.filter(l => l.phase === 1).map(l => l.id);
        const phase1Done = p1Ids.every(id => state.completedLessonIds.includes(id));
        const allLessonsDone = LESSONS.every(l => state.completedLessonIds.includes(l.id));

        const badges = [
          { title: 'First win', desc: 'Get your first exercise right', icon: '🌟', unlocked: state.score > 0 || state.completedExerciseIds.length > 0 },
          { title: '5 in a row', desc: 'Reach a streak of 5 correct answers', icon: '🔥', unlocked: state.bestStreak >= 5 },
          { title: '10 in a row', desc: 'Reach a streak of 10 correct answers', icon: '⚡', unlocked: state.bestStreak >= 10 },
          { title: 'Phase 1 done', desc: 'Complete all Phase 1 foundation lessons', icon: '🧱', unlocked: phase1Done },
          { title: 'All lessons done', desc: 'Master all 9 lessons across Phases 1–3', icon: '👑', unlocked: allLessonsDone },
          { title: 'Asked the mentor', desc: 'Submit a question in the Teacher Hub', icon: '🎓', unlocked: state.askedMentor }
        ];

        const badgesGrid = document.getElementById('badges-grid');
        badgesGrid.innerHTML = '';
        badges.forEach(b => {
          const card = document.createElement('div');
          card.className = `p-3.5 rounded-xl border transition flex items-start gap-3 ${
            b.unlocked
              ? 'bg-emerald-500/10 border-emerald-500/40 text-slate-900 dark:text-white shadow-sm'
              : 'bg-slate-100/70 dark:bg-slate-950/50 border-slate-200 dark:border-slate-800 opacity-50 grayscale'
          }`;
          card.innerHTML = `
            <span class="text-2xl">${b.icon}</span>
            <div>
              <div class="font-bold text-xs sm:text-sm">${b.title}</div>
              <div class="text-[11px] text-slate-500 dark:text-slate-400">${b.desc}</div>
            </div>
          `;
          badgesGrid.appendChild(card);
        });

        // Weak-Spot Tags
        const weakContainer = document.getElementById('prog-weakspots-container');
        weakContainer.innerHTML = '';
        const weakEntries = Object.entries(state.weakSpots || {}).sort((a, b) => b[1] - a[1]);
        if (!weakEntries.length) {
          weakContainer.innerHTML = `<span class="text-xs text-slate-500">No weak spots triggered yet — complete exercises in Practice to see diagnostic tags.</span>`;
        } else {
          weakEntries.forEach(([tag, count]) => {
            const pill = document.createElement('span');
            pill.className = 'px-3 py-1.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-400 text-xs font-bold';
            pill.textContent = `${tag} (${count})`;
            weakContainer.appendChild(pill);
          });
        }

        // Recap View for Training Meeting (<details> list with py-3 tap targets)
        const recapList = document.getElementById('recap-details-list');
        recapList.innerHTML = '';
        LESSONS.forEach((l, idx) => {
          const det = document.createElement('details');
          det.className = 'group';
          det.innerHTML = `
            <summary class="py-3 cursor-pointer list-none flex items-center justify-between gap-2 font-bold text-xs sm:text-sm hover:text-emerald-500">
              <div>
                <span>${idx + 1}. ${l.title}</span>
                <span dir="rtl" class="block sm:inline sm:ml-2 font-arabic text-emerald-600 dark:text-emerald-400">${l.titleAr}</span>
              </div>
              <span class="group-open:rotate-180 transition-transform text-xs">▼</span>
            </summary>
            <div class="pb-4 pt-1 space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
              <p>${l.transferConcept}</p>
              <p dir="rtl" class="font-arabic text-emerald-700 dark:text-emerald-300 font-semibold text-base">${l.transferConceptAr}</p>
            </div>
          `;
          recapList.appendChild(det);
        });
      }

      // ------------------------- PRESENTATION MODE -------------------------
      function renderPresentationSlide() {
        const l = LESSONS[presentationIndex] || LESSONS[0];
        document.getElementById('pres-phase-badge').textContent = `Phase ${l.phase}`;
        document.getElementById('pres-counter').textContent = `${presentationIndex + 1} / ${LESSONS.length}`;
        document.getElementById('pres-title-en').textContent = l.title;
        document.getElementById('pres-title-ar').textContent = l.titleAr;
        document.getElementById('pres-concept-en').textContent = l.transferConcept;
        document.getElementById('pres-concept-ar').textContent = l.transferConceptAr;
        document.getElementById('pres-prev-btn').disabled = presentationIndex === 0;
        document.getElementById('pres-next-btn').disabled = presentationIndex === LESSONS.length - 1;
      }

      // =======================================================================
      // 10. EVENT LISTENERS WIRING
      // =======================================================================
      // Tab navigation
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => switchTab(btn.getAttribute('data-tab')));
      });

      // Theme toggles
      function toggleTheme() {
        state.theme = state.theme === 'dark' ? 'light' : 'dark';
        StorageVault.save(state);
        applyTheme();
      }
      document.getElementById('mobile-theme-btn').addEventListener('click', toggleTheme);
      document.getElementById('desktop-theme-btn').addEventListener('click', toggleTheme);

      // Security Vault Modal
      function openVaultModal() {
        const modal = document.getElementById('vault-modal');
        document.getElementById('vault-audit-json').textContent = JSON.stringify({
          integrityChecksum: state.lastAuditHash,
          score: state.score,
          streak: state.streak,
          bestStreak: state.bestStreak,
          completedLessons: state.completedLessonIds,
          weakSpots: state.weakSpots
        }, null, 2);
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
      document.getElementById('mobile-vault-btn').addEventListener('click', openVaultModal);
      document.getElementById('desktop-vault-btn').addEventListener('click', openVaultModal);
      document.getElementById('close-vault-btn').addEventListener('click', () => {
        const modal = document.getElementById('vault-modal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      });
      document.getElementById('reset-progress-btn').addEventListener('click', () => {
        state = StorageVault.reset();
        applyTheme();
        updateHeaderAndSidebarStats();
        switchTab(activeTab);
        document.getElementById('vault-modal').classList.add('hidden');
        document.getElementById('vault-modal').classList.remove('flex');
        showToast('Demo data reset cleanly.', 'emerald');
      });

      // Practice Tab Events
      document.getElementById('practice-lesson-select').addEventListener('change', (e) => {
        currentLessonIndex = parseInt(e.target.value, 10) || 0;
        currentExerciseIndex = 0;
        renderPracticeTab();
      });
      document.getElementById('clear-answer-btn').addEventListener('click', () => {
        selectedChips = [];
        document.getElementById('practice-input').value = '';
        renderWordChips(LESSONS[currentLessonIndex].exercises[currentExerciseIndex]);
      });
      document.getElementById('check-answer-btn').addEventListener('click', handleCheckAnswer);
      document.getElementById('practice-input').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          handleCheckAnswer();
        }
      });
      document.getElementById('reveal-answer-btn').addEventListener('click', handleRevealAnswer);
      document.getElementById('next-exercise-btn').addEventListener('click', handleNextExercise);

      // Voice & TTS Events
      document.getElementById('tts-normal-btn').addEventListener('click', () => {
        const ex = LESSONS[currentLessonIndex].exercises[currentExerciseIndex];
        speakEnglish(ex.target, 1.0);
      });
      document.getElementById('tts-slow-btn').addEventListener('click', () => {
        const ex = LESSONS[currentLessonIndex].exercises[currentExerciseIndex];
        speakEnglish(ex.target, 0.6);
      });
      document.getElementById('voice-picker-select').addEventListener('change', (e) => {
        state.preferredVoiceURI = e.target.value;
        StorageVault.save(state);
        speakEnglish('Thinking English voice selected.', 1.0);
      });

      // Pronunciation Events
      document.getElementById('pron-record-btn').addEventListener('click', startPronunciationCheck);
      document.getElementById('pron-play-self-btn').addEventListener('click', () => {
        if (selfPronAudioUrl) {
          const a = new Audio(selfPronAudioUrl);
          a.play().catch(() => {});
        }
      });

      // Teacher Hub Events
      let mentorRecorder = null;
      let mentorChunks = [];
      document.getElementById('mentor-voice-btn').addEventListener('click', () => {
        const label = document.getElementById('mentor-voice-label');
        const status = document.getElementById('mentor-voice-status');
        if (mentorRecorder && mentorRecorder.state === 'recording') {
          mentorRecorder.stop();
          label.textContent = 'Record Voice Note';
          return;
        }
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          showToast('Microphone recording is not available on this device.', 'amber');
          return;
        }
        navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
          mentorChunks = [];
          mentorRecorder = new MediaRecorder(stream);
          mentorRecorder.ondataavailable = e => {
            if (e.data && e.data.size > 0) mentorChunks.push(e.data);
          };
          mentorRecorder.onstop = () => {
            const blob = new Blob(mentorChunks, { type: 'audio/webm' });
            const reader = new FileReader();
            reader.onloadend = () => {
              mentorAudioDataUrl = String(reader.result || '');
              const preview = document.getElementById('mentor-voice-preview');
              preview.src = mentorAudioDataUrl;
              preview.classList.remove('hidden');
              status.textContent = 'Voice note ready';
            };
            reader.readAsDataURL(blob);
            stream.getTracks().forEach(t => t.stop());
          };
          mentorRecorder.start();
          label.textContent = '⏹️ Stop Recording';
          status.textContent = 'Recording…';
          setTimeout(() => {
            if (mentorRecorder && mentorRecorder.state === 'recording') {
              mentorRecorder.stop();
              label.textContent = 'Record Voice Note';
            }
          }, 8000);
        }).catch(() => {
          showToast('Microphone permission denied.', 'rose');
        });
      });

      document.getElementById('submit-mentor-question-btn').addEventListener('click', () => {
        const nameInp = document.getElementById('mentor-student-name');
        const qInp = document.getElementById('mentor-question-input');
        const qText = qInp.value.trim();
        if (!qText && !mentorAudioDataUrl) {
          showToast('Please write a question or record a voice note first.', 'amber');
          return;
        }
        state.mentorQuestions.unshift({
          id: 'q-' + Date.now(),
          student: nameInp.value.trim() || 'Student',
          question: qText || '[Voice Note Question]',
          audioDataUrl: mentorAudioDataUrl,
          reply: '',
          createdAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
        });
        state.askedMentor = true;
        StorageVault.save(state);
        qInp.value = '';
        mentorAudioDataUrl = '';
        document.getElementById('mentor-voice-preview').classList.add('hidden');
        document.getElementById('mentor-voice-status').textContent = 'No audio attached';
        renderTeacherTab();
        showToast('Question saved! “Asked the mentor” badge unlocked.', 'emerald');
      });

      document.getElementById('teacher-pin-btn').addEventListener('click', () => {
        const pinVal = document.getElementById('teacher-pin-input').value.trim();
        if (pinVal === TEACHER_PIN) {
          teacherUnlocked = true;
          renderTeacherUnlockedConsole();
          showToast('Instructor console unlocked.', 'emerald');
        } else {
          showToast('Incorrect PIN (Use 1234 for demo).', 'rose');
        }
      });

      document.getElementById('teacher-broadcast-btn').addEventListener('click', () => {
        const msg = document.getElementById('teacher-broadcast-input').value.trim();
        state.broadcastMessage = msg;
        StorageVault.save(state);
        updateHeaderAndSidebarStats();
        showToast(msg ? 'Broadcast mini-lesson published!' : 'Broadcast cleared.', 'emerald');
      });

      document.getElementById('dismiss-broadcast-btn').addEventListener('click', () => {
        state.broadcastMessage = '';
        StorageVault.save(state);
        updateHeaderAndSidebarStats();
      });

      // Progress Tab Events: Sound toggle, Presentation mode, Feedback channel
      document.getElementById('sound-toggle-btn').addEventListener('click', () => {
        state.soundOn = !state.soundOn;
        StorageVault.save(state);
        renderProgressTab();
        if (state.soundOn) beep(true, true);
      });

      document.getElementById('open-presentation-btn').addEventListener('click', () => {
        presentationIndex = 0;
        renderPresentationSlide();
        const modal = document.getElementById('presentation-modal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
      document.getElementById('pres-close-btn').addEventListener('click', () => {
        const modal = document.getElementById('presentation-modal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      });
      document.getElementById('pres-prev-btn').addEventListener('click', () => {
        if (presentationIndex > 0) {
          presentationIndex--;
          renderPresentationSlide();
        }
      });
      document.getElementById('pres-next-btn').addEventListener('click', () => {
        if (presentationIndex < LESSONS.length - 1) {
          presentationIndex++;
          renderPresentationSlide();
        }
      });
      window.addEventListener('keydown', (e) => {
        const modal = document.getElementById('presentation-modal');
        if (modal.classList.contains('hidden')) return;
        if (e.key === 'ArrowRight' && presentationIndex < LESSONS.length - 1) {
          presentationIndex++;
          renderPresentationSlide();
        } else if (e.key === 'ArrowLeft' && presentationIndex > 0) {
          presentationIndex--;
          renderPresentationSlide();
        } else if (e.key === 'Escape') {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      });

      // Feedback Emoji Rating & Channel Buttons
      document.querySelectorAll('.rating-emoji-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          selectedRating = parseInt(btn.getAttribute('data-rating'), 10) || 0;
          document.querySelectorAll('.rating-emoji-btn').forEach(b => {
            const active = parseInt(b.getAttribute('data-rating'), 10) === selectedRating;
            b.className = `rating-emoji-btn flex-1 py-2.5 rounded-xl text-2xl transition border-2 ${
              active
                ? 'bg-emerald-500/20 border-emerald-500 scale-105'
                : 'bg-slate-100 dark:bg-slate-800 border-transparent'
            }`;
          });
        });
      });

      function buildCurrentFeedbackMessage() {
        const text = document.getElementById('feedback-textarea').value.trim();
        return feedbackMessage(selectedRating, text, state, LESSONS.length);
      }

      document.getElementById('fb-whatsapp-btn').addEventListener('click', () => {
        const msg = buildCurrentFeedbackMessage();
        window.open(waLink(msg), '_blank', 'noopener,noreferrer');
      });

      document.getElementById('fb-email-btn').addEventListener('click', () => {
        const msg = buildCurrentFeedbackMessage();
        window.location.href = mailLink(msg);
      });

      document.getElementById('fb-copy-btn').addEventListener('click', async () => {
        const msg = buildCurrentFeedbackMessage();
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(msg);
            showToast('Feedback copied to clipboard!', 'emerald');
            return;
          }
        } catch (err) {}
        // Fallback copy method
        try {
          const ta = document.createElement('textarea');
          ta.value = msg;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
          showToast('Feedback copied to clipboard!', 'emerald');
        } catch (err) {
          showToast('Could not copy automatically — please select and copy your note.', 'amber');
        }
      });

      document.getElementById('fb-google-form-link').href = FEEDBACK_FORM_URL;

      // =======================================================================
      // 11. INITIALIZE APPLICATION ON FIRST LOAD
      // =======================================================================
      applyTheme();
      updateHeaderAndSidebarStats();
      switchTab('lessons');
    })();
  </script>
</body>
</html>