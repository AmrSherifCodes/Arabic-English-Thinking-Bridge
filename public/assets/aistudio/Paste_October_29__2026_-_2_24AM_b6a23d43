<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Thinking English — Arabic-to-English Cognitive Transfer</title>
  <!-- Google Fonts: Inter & Cairo -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            arabic: ['Cairo', 'sans-serif'],
          }
        }
      }
    };
  </script>
  <style>
    :root {
      --safe-bottom: env(safe-area-inset-bottom, 0px);
    }
    html, body {
      overflow-x: hidden;
      -webkit-tap-highlight-color: transparent;
    }
    .font-arabic {
      font-family: 'Cairo', sans-serif;
    }
    /* Touch target & iOS zoom prevention rules */
    button, select, .chip-btn, .tab-btn, summary {
      min-height: 44px;
      min-width: 44px;
      touch-action: manipulation;
    }
    input, textarea, select {
      font-size: 16px !important;
    }
    .pb-safe-main {
      padding-bottom: calc(92px + var(--safe-bottom));
    }
    .pb-safe-nav {
      padding-bottom: var(--safe-bottom);
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-8px); }
      40%, 80% { transform: translateX(8px); }
    }
    @keyframes fall {
      to { transform: translateY(105vh) rotate(540deg); opacity: .2; }
    }
    .shake {
      animation: shake .35s;
      border-color: #e11d48 !important;
    }
    .conf {
      position: fixed;
      top: -30px;
      font-size: 24px;
      pointer-events: none;
      z-index: 50;
      animation: fall 1.6s ease-in forwards;
    }
    @media (prefers-reduced-motion: reduce) {
      .shake {
        animation: none !important;
      }
      .conf {
        animation: none !important;
        display: none !important;
      }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 font-sans antialiased selection:bg-emerald-500 selection:text-white transition-colors duration-200">

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center gap-2 pointer-events-none w-11/12 max-w-md"></div>

  <!-- Presentation Mode Fullscreen Modal -->
  <div id="presentation-modal" class="fixed inset-0 z-50 hidden bg-slate-950/95 backdrop-blur-md text-white flex-col justify-between p-6 md:p-12">
    <div class="flex items-center justify-between border-b border-slate-800 pb-4">
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-sm font-semibold border border-emerald-500/30" id="pres-phase-badge">Phase 1</span>
        <span class="text-slate-400 text-sm font-medium" id="pres-counter">1 / 9</span>
      </div>
      <button id="pres-close-btn" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm flex items-center gap-2">
        <span>✕ Close Presentation</span>
      </button>
    </div>
    <div class="my-auto max-w-4xl mx-auto w-full space-y-8 text-center">
      <div class="space-y-3">
        <h2 id="pres-title-en" class="text-3xl md:text-5xl font-extrabold tracking-tight text-white"></h2>
        <p id="pres-title-ar" dir="rtl" class="text-2xl md:text-4xl font-arabic font-bold text-emerald-400"></p>
      </div>
      <div class="p-6 md:p-10 rounded-3xl bg-slate-900/90 border border-slate-800 space-y-6 text-left shadow-2xl">
        <div>
          <div class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-2">English Cognitive Transfer Rule</div>
          <p id="pres-concept-en" class="text-xl md:text-3xl leading-relaxed text-slate-100 font-medium"></p>
        </div>
        <hr class="border-slate-800" />
        <div dir="rtl" class="text-right">
          <div class="text-xs uppercase tracking-wider text-emerald-400 font-bold mb-2 font-sans">القاعدة الذهنية للتحويل اللغوي</div>
          <p id="pres-concept-ar" class="text-2xl md:text-3xl leading-relaxed font-arabic text-emerald-100 font-semibold"></p>
        </div>
      </div>
    </div>
    <div class="flex items-center justify-between border-t border-slate-800 pt-4 max-w-4xl mx-auto w-full">
      <button id="pres-prev-btn" class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 font-semibold text-base disabled:opacity-40">← Previous Concept</button>
      <span class="text-xs text-slate-500 hidden sm:inline">Use ← / → arrow keys or tap buttons</span>
      <button id="pres-next-btn" class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-base disabled:opacity-40">Next Concept →</button>
    </div>
  </div>

  <!-- Bank-Grade Vault Inspector Modal -->
  <div id="vault-modal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-lg w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-emerald-500 text-xl">🛡️</span>
          <h3 class="font-bold text-lg">Security & Deterministic Vault Status</h3>
        </div>
        <button id="close-vault-btn" class="px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-sm font-semibold">✕</button>
      </div>
      <div class="text-xs space-y-2 text-slate-600 dark:text-slate-300">
        <p>• <strong>Zero-Hallucination Engine:</strong> 100% deterministic contrast matrices reviewed by ESL pedagogues. No unverified generative text mutations.</p>
        <p>• <strong>Isolated StorageVault:</strong> Every state read/write passes schema sanitization, FNV-1a integrity checksum verification, and strict <code>try/catch</code> isolation.</p>
      </div>
      <pre id="vault-audit-json" class="bg-slate-950 text-emerald-400 p-3 rounded-xl text-xs overflow-x-auto max-h-60 font-mono"></pre>
      <div class="flex justify-end gap-2">
        <button id="reset-progress-btn" class="px-4 py-2 rounded-xl bg-rose-600/10 text-rose-600 dark:text-rose-400 border border-rose-500/30 text-xs font-semibold">Reset Local Demo Data</button>
      </div>
    </div>
  </div>

  <!-- App Layout Wrapper -->
  <div class="min-h-screen flex flex-col md:flex-row">

    <!-- Desktop Sidebar / Mobile Fixed Bottom Navigation -->
    <nav aria-label="Main Navigation" class="fixed bottom-0 inset-x-0 z-40 bg-white/85 dark:bg-slate-900/85 backdrop-blur-lg border-t border-slate-200 dark:border-slate-800 pb-safe-nav md:static md:w-64 md:min-h-screen md:border-t-0 md:border-r md:flex md:flex-col md:justify-between md:p-4">
      <div class="hidden md:block space-y-4">
        <div class="flex items-center gap-3 px-2 py-2">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white font-black text-lg shadow-md">TE</div>
          <div>
            <h1 class="font-extrabold text-base tracking-tight leading-none">Thinking English</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-arabic" dir="rtl">التفكير بالإنجليزية</p>
          </div>
        </div>
        <div class="p-3 rounded-xl bg-slate-100 dark:bg-slate-800/70 border border-slate-200/70 dark:border-slate-700/60 space-y-1.5">
          <div class="flex items-center justify-between text-xs font-semibold">
            <span id="sidebar-level-name" class="text-emerald-600 dark:text-emerald-400">Silent Copula</span>
            <span id="sidebar-score-badge" class="font-bold">0 XP</span>
          </div>
          <div class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
            <div id="sidebar-level-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 0%"></div>
          </div>
          <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 pt-0.5">
            <span>🔥 Streak: <strong id="sidebar-streak">0</strong></span>
            <span>Best: <strong id="sidebar-best-streak">0</strong></span>
          </div>
        </div>
      </div>

      <!-- Navigation Buttons -->
      <div class="grid grid-cols-4 md:grid-cols-1 gap-1 px-2 py-1.5 md:p-0 md:my-auto">
        <button data-tab="lessons" class="tab-btn flex flex-col md:flex-row items-center justify-center md:justify-start gap-1 md:gap-3 px-2 md:px-4 py-1.5 md:py-3 rounded-xl font-semibold text-xs md:text-sm transition-colors">
          <span class="text-lg md:text-xl">📚</span>
          <span>Lessons</span>
        </button>
        <button data-tab="practice" class="tab-btn flex flex-col md:flex-row items-center justify-center md:justify-start gap-1 md:gap-3 px-2 md:px-4 py-1.5 md:py-3 rounded-xl font-semibold text-xs md:text-sm transition-colors">
          <span class="text-lg md:text-xl">⚡</span>
          <span>Practice</span>
        </button>
        <button data-tab="teacher" class="tab-btn flex flex-col md:flex-row items-center justify-center md:justify-start gap-1 md:gap-3 px-2 md:px-4 py-1.5 md:py-3 rounded-xl font-semibold text-xs md:text-sm transition-colors">
          <span class="text-lg md:text-xl">🎓</span>
          <span>Teacher Hub</span>
        </button>
        <button data-tab="progress" class="tab-btn flex flex-col md:flex-row items-center justify-center md:justify-start gap-1 md:gap-3 px-2 md:px-4 py-1.5 md:py-3 rounded-xl font-semibold text-xs md:text-sm transition-colors">
          <span class="text-lg md:text-xl">🏆</span>
          <span>Progress</span>
        </button>
      </div>

      <!-- Desktop Footer Controls -->
      <div class="hidden md:flex flex-col gap-2 pt-4 border-t border-slate-200 dark:border-slate-800">
        <button id="desktop-vault-btn" class="w-full px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-800 text-xs font-semibold flex items-center justify-between text-slate-600 dark:text-slate-300">
          <span>🛡️ Vault Integrity</span>
          <span class="text-emerald-500 font-mono">VERIFIED</span>
        </button>
        <button id="desktop-theme-btn" class="w-full px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-800 text-xs font-semibold flex items-center justify-between">
          <span>Theme Mode</span>
          <span class="theme-label">🌙 Dark</span>
        </button>
      </div>
    </nav>

    <!-- Main Content Column -->
    <div class="flex-1 flex flex-col min-w-0 pb-safe-main md:pb-10">

      <!-- Top Sticky Header -->
      <header class="sticky top-0 z-30 bg-white/85 dark:bg-slate-950/85 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 px-4 py-2.5">
        <div class="max-w-4xl mx-auto flex items-center justify-between gap-2">
          <div class="flex items-center gap-2.5">
            <div class="md:hidden w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white font-black text-sm shadow">TE</div>
            <div>
              <h2 id="header-title" class="font-bold text-sm sm:text-base leading-tight">Curriculum Map</h2>
              <p id="header-subtitle" class="text-[11px] text-slate-500 dark:text-slate-400">Arabic-to-English Cognitive Transfer</p>
            </div>
          </div>

          <div class="flex items-center gap-1.5 sm:gap-2">
            <!-- Score & Streak Pill -->
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold">
              <span title="Current Streak">🔥 <span id="header-streak">0</span></span>
              <span class="text-slate-300 dark:text-slate-700">|</span>
              <span class="text-emerald-600 dark:text-emerald-400"><span id="header-score">0</span> XP</span>
            </div>
            <!-- Security Vault Status Button -->
            <button id="mobile-vault-btn" title="Security & Vault Audit" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm">
              🛡️
            </button>
            <!-- Theme Toggle -->
            <button id="mobile-theme-btn" title="Toggle Dark/Light Theme" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm">
              <span class="theme-icon">🌙</span>
            </button>
          </div>
        </div>
      </header>

      <!-- Main View Container -->
      <main class="max-w-4xl w-full mx-auto px-4 pt-4 space-y-6">

        <!-- Broadcast Banner (if teacher posted a mini-lesson) -->
        <div id="broadcast-banner" class="hidden p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-900 dark:text-amber-200 flex items-start justify-between gap-3">
          <div class="space-y-1">
            <div class="text-xs font-extrabold uppercase tracking-wider text-amber-600 dark:text-amber-400">📢 Teacher Broadcast Mini-Lesson</div>
            <p id="broadcast-banner-text" class="text-sm font-medium"></p>
          </div>
          <button id="dismiss-broadcast-btn" class="text-xs px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 font-semibold">Dismiss</button>
        </div>

        <!-- ==========================================
             TAB 1: LESSONS VIEW
             ========================================== -->
        <section id="view-lessons" class="space-y-6">
          <div class="p-5 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-700 text-white shadow-lg space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="px-2.5 py-0.5 rounded-full bg-white/20 text-xs font-bold uppercase tracking-wider">The Thinking Method</span>
              <span id="lessons-overall-progress" class="text-xs font-semibold bg-black/20 px-3 py-1 rounded-full">0 / 9 Completed</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-extrabold">Rewire Arabic Thought Patterns into Natural English</h3>
            <p class="text-xs sm:text-sm text-emerald-50 max-w-2xl">Zero rote memorization. We compare how your brain structures a sentence in Arabic with how English builds the exact same idea.</p>
          </div>

          <!-- Phases Container -->
          <div id="phases-container" class="space-y-6"></div>
        </section>

        <!-- ==========================================
             TAB 2: PRACTICE VIEW (THE LEARNING LOOP)
             ========================================== -->
        <section id="view-practice" class="hidden space-y-4">
          <!-- Lesson Header & Thin Progress Bar -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-sm space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <span id="practice-phase-tag" class="text-[11px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Phase 1</span>
                <h3 id="practice-lesson-title" class="font-bold text-base sm:text-lg">Lesson Title</h3>
              </div>
              <div class="flex items-center gap-2">
                <select id="practice-lesson-select" aria-label="Switch Lesson" class="px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold"></select>
              </div>
            </div>

            <!-- Thin Progress Bar within Lesson -->
            <div class="space-y-1">
              <div class="flex justify-between text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                <span id="practice-step-label">Exercise 1 of 3</span>
                <span id="practice-points-badge" class="text-emerald-600 dark:text-emerald-400">+10 XP on first try</span>
              </div>
              <div class="w-full h-1.5 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                <div id="practice-progress-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 33%"></div>
              </div>
            </div>

            <!-- Collapsible Transfer Concept Reminder -->
            <details class="group rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-800 px-3.5 py-2">
              <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold text-slate-600 dark:text-slate-300">
                <span>💡 View Transfer Logic Hint (القاعدة الذهنية)</span>
                <span class="group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <div class="pt-2.5 mt-2 border-t border-slate-200 dark:border-slate-700/70 space-y-1.5 text-xs">
                <p id="practice-concept-en" class="text-slate-700 dark:text-slate-200 font-medium"></p>
                <p id="practice-concept-ar" dir="rtl" class="font-arabic text-emerald-600 dark:text-emerald-400 font-semibold text-sm"></p>
              </div>
            </details>
          </div>

          <!-- STEP 1: SHOW (Arabic Thought Only) -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 sm:p-6 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold">1. SHOW — Arabic Thought</span>
              <span id="exercise-category-tag" class="text-xs font-medium text-slate-500 dark:text-slate-400">Category</span>
            </div>

            <!-- Large RTL Arabic Prompt -->
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200/70 dark:border-slate-800/80 text-right">
              <p id="arabic-prompt" dir="rtl" class="text-3xl sm:text-4xl font-arabic font-bold text-slate-900 dark:text-white leading-snug break-words"></p>
              <p id="arabic-literal-gloss" class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-mono"></p>
            </div>

            <!-- STEP 2: PAUSE & CONSTRUCT -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-bold">2. CONSTRUCT — Build in English</span>
                <button id="clear-answer-btn" class="text-xs font-semibold text-slate-500 hover:text-rose-500 px-2 py-1 rounded-lg">Reset Words</button>
              </div>

              <!-- Selected Word Chips Tray -->
              <div id="selected-chips-tray" class="min-h-[56px] p-2.5 rounded-xl bg-slate-100/80 dark:bg-slate-950 border-2 border-dashed border-slate-300 dark:border-slate-800 flex flex-wrap items-center gap-2"></div>

              <!-- Available Word Chips Bank -->
              <div id="word-bank-tray" class="flex flex-wrap gap-2 pt-1"></div>

              <!-- Direct Text Input (Synced with chips or direct typing) -->
              <div class="pt-1">
                <label for="practice-input" class="sr-only">Type or refine your English sentence</label>
                <input id="practice-input" type="text" autocomplete="off" autocorrect="off" autocapitalize="sentences" spellcheck="false" placeholder="Tap word chips above or type your English sentence here…" class="w-full px-4 py-3 rounded-xl bg-white dark:bg-slate-950 border-2 border-slate-300 dark:border-slate-700 focus:border-emerald-500 focus:outline-none font-medium transition-colors" />
              </div>

              <!-- Action Buttons: Check vs Reveal -->
              <div class="flex flex-wrap items-center gap-2.5 pt-1">
                <button id="check-answer-btn" class="flex-1 px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-[0.99] text-white font-bold text-sm shadow-md shadow-emerald-600/20 transition">
                  ✓ Check Answer
                </button>
                <button id="reveal-answer-btn" class="px-4 py-3 rounded-xl bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold text-sm transition">
                  👁️ Reveal Answer
                </button>
              </div>
            </div>

            <!-- STEP 3: SOCRATIC FEEDBACK (Check Diagnosis) -->
            <div id="socratic-feedback-box" class="hidden p-4 rounded-2xl border space-y-2">
              <div class="flex items-center gap-2 font-bold text-sm" id="socratic-feedback-title"></div>
              <p id="socratic-feedback-en" class="text-sm leading-relaxed"></p>
              <p id="socratic-feedback-ar" dir="rtl" class="text-base font-arabic font-semibold leading-relaxed"></p>
            </div>

            <!-- STEP 4: REVEAL & COLOR-CODED BREAKDOWN + VOICE + PRONUNCIATION -->
            <div id="reveal-breakdown-box" class="hidden space-y-4 pt-3 border-t border-slate-200 dark:border-slate-800">
              <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 space-y-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="text-xs font-extrabold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">4. REVEAL — Target English Structure</span>
                  <div class="flex flex-wrap items-center gap-1.5">
                    <button id="tts-normal-btn" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold flex items-center gap-1">
                      🔊 Hear
                    </button>
                    <button id="tts-slow-btn" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold flex items-center gap-1" title="Play at slow speed">
                      🐌 Slow
                    </button>
                    <select id="voice-picker-select" aria-label="Select English Voice" class="px-2.5 py-1.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs font-medium max-w-[180px] truncate"></select>
                  </div>
                </div>

                <p id="reveal-target-sentence" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white"></p>

                <!-- Color-Coded Breakdown Mapping -->
                <div class="space-y-2 pt-2">
                  <div class="text-xs font-bold text-slate-500 dark:text-slate-400">Visual Cognitive Chunk Mapping (Subject [Red] → Verb [Blue] → Object/Complement [Green]):</div>
                  <div id="chunk-mapping-grid" class="grid grid-cols-1 sm:grid-cols-3 gap-2.5"></div>
                </div>
              </div>

              <!-- Pronunciation Practice (Record & Compare) -->
              <div class="p-4 rounded-2xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-3">
