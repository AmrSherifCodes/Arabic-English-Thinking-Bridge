      // =======================================================================
      // 3. BANK-GRADE DETERMINISTIC STORAGE VAULT (src/utils/storage.ts port)
      //    - The ONLY place where localStorage is touched
      //    - Every single read/write wrapped in try/catch
      //    - FNV-1a integrity checksum & strict schema sanitization
      // =======================================================================
      const STORAGE_KEY = 'thinking_english_vault_v2';
      let memoryFallbackVault = null;

      function computeChecksum(payloadStr) {
        let hash = 2166136261;
        for (let i = 0; i < payloadStr.length; i++) {
          hash ^= payloadStr.charCodeAt(i);
          hash += (hash << 1) + (hash << 4) + (hash << 7) + (hash << 8) + (hash << 24);
        }
        return (hash >>> 0).toString(16);
      }

      function defaultState() {
        return {
          score: 0,
          streak: 0,
          bestStreak: 0,
          soundOn: true,
          theme: 'dark',
          preferredVoiceURI: '',
          completedLessonIds: [],
          completedExerciseIds: [],
          weakSpots: {},
          askedMentor: false,
          mentorQuestions: [
            {
              id: 'demo-q1',
              student: 'Amr Ibrahim',
              question: 'When translating “العلماء يدرسون المياه”, why don’t we say “The scientists study the water”?',
              audioDataUrl: '',
              reply: 'Great observation! In Arabic, generic plural/uncountable nouns take “الـ” (الجنس). In English, general concepts drop “the”: “Scientists study water.”',
              createdAt: 'Demo Thread'
            }
          ],
          broadcastMessage: '',
          lastAuditHash: ''
        };
      }

      function sanitizeState(raw) {
        const def = defaultState();
        if (!raw || typeof raw !== 'object') return def;
        return {
          score: Number.isFinite(raw.score) && raw.score >= 0 ? Math.floor(raw.score) : def.score,
          streak: Number.isFinite(raw.streak) && raw.streak >= 0 ? Math.floor(raw.streak) : def.streak,
          bestStreak: Number.isFinite(raw.bestStreak) && raw.bestStreak >= 0 ? Math.floor(raw.bestStreak) : def.bestStreak,
          soundOn: typeof raw.soundOn === 'boolean' ? raw.soundOn : def.soundOn,
          theme: raw.theme === 'light' ? 'light' : 'dark',
          preferredVoiceURI: typeof raw.preferredVoiceURI === 'string' ? raw.preferredVoiceURI.slice(0, 160) : '',
          completedLessonIds: Array.isArray(raw.completedLessonIds) ? raw.completedLessonIds.filter(x => typeof x === 'string') : [],
          completedExerciseIds: Array.isArray(raw.completedExerciseIds) ? raw.completedExerciseIds.filter(x => typeof x === 'string') : [],
          weakSpots: raw.weakSpots && typeof raw.weakSpots === 'object' ? raw.weakSpots : {},
          askedMentor: Boolean(raw.askedMentor),
          mentorQuestions: Array.isArray(raw.mentorQuestions) ? raw.mentorQuestions.slice(0, 30) : def.mentorQuestions,
          broadcastMessage: typeof raw.broadcastMessage === 'string' ? raw.broadcastMessage.slice(0, 300) : '',
          lastAuditHash: typeof raw.lastAuditHash === 'string' ? raw.lastAuditHash : ''
        };
      }

      const StorageVault = {
        load() {
          try {
            const rawStr = window.localStorage.getItem(STORAGE_KEY);
            if (!rawStr) {
              const init = defaultState();
              this.save(init);
              return init;
            }
            const parsed = JSON.parse(rawStr);
            const clean = sanitizeState(parsed.data || parsed);
            return clean;
          } catch (err) {
            if (memoryFallbackVault) return sanitizeState(memoryFallbackVault);
            memoryFallbackVault = defaultState();
            return memoryFallbackVault;
          }
        },
        save(nextState) {
          const clean = sanitizeState(nextState);
          const serializedData = JSON.stringify({ ...clean, lastAuditHash: '' });
          clean.lastAuditHash = computeChecksum(serializedData);
          memoryFallbackVault = clean;
          try {
            window.localStorage.setItem(STORAGE_KEY, JSON.stringify({
              version: 2,
              checksum: clean.lastAuditHash,
              updatedAt: new Date().toISOString(),
              data: clean
            }));
          } catch (err) {
            // Gracefully falls back to in-memory vault if storage quota or private mode blocks writes
          }
          return clean;
        },
        reset() {
          const fresh = defaultState();
          try {
            window.localStorage.removeItem(STORAGE_KEY);
          } catch (err) {}
          return this.save(fresh);
        }
      };

      // =======================================================================
