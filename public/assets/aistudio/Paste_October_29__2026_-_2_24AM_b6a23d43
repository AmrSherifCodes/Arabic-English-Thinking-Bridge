          const earnedPoints = currentRetryCount === 0 ? 10 : 5;
          state.score += earnedPoints;
          state.streak += 1;
          if (state.streak > state.bestStreak) state.bestStreak = state.streak;

          if (!state.completedExerciseIds.includes(ex.id)) {
            state.completedExerciseIds.push(ex.id);
          }

          // Check if all exercises in this lesson are done
          const allExDone = lesson.exercises.every(e => state.completedExerciseIds.includes(e.id));
          if (allExDone && !state.completedLessonIds.includes(lesson.id)) {
            state.completedLessonIds.push(lesson.id);
          }

          StorageVault.save(state);
          updateHeaderAndSidebarStats();

          // Streak toasts at 3, 5, and 10 in a row
          if ([3, 5, 10].includes(state.streak)) {
            showToast(`🔥 ${state.streak} in a row!`, 'amber');
          } else {
            showToast(`+${earnedPoints} XP! Great cognitive transfer!`, 'emerald');
