      function beep(ok, soundOn) {
        if (soundOn) {
          try {
            const AC = window.AudioContext || window.webkitAudioContext;
            const a = new AC();
            (ok ? [523, 659, 784] : [200, 150]).forEach((f, i) => {
              const o = a.createOscillator(), g = a.createGain(), t = a.currentTime + i * 0.1;
              o.frequency.value = f;
              o.type = ok ? 'triangle' : 'sawtooth';
              o.connect(g);
              g.connect(a.destination);
              g.gain.setValueAtTime(0.12, t);
              g.gain.exponentialRampToValueAtTime(0.001, t + 0.18);
              o.start(t);
              o.stop(t + 0.2);
            });
          } catch (e) {}
        }
        try {
          if (navigator.vibrate) {
            navigator.vibrate(ok ? [20, 40, 20] : 80);
          }
        } catch (e) {}
      }

      function confetti() {
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const E = ['🎉', '⭐', '✨', '🔥', '💚'];
          for (let i = 0; i < 26; i++) {
            const s = document.createElement('span');
            s.className = 'conf';
            s.textContent = E[i % 5];
            s.style.left = Math.random() * 95 + '%';
            s.style.animationDelay = Math.random() * 0.4 + 's';
            document.body.appendChild(s);
            setTimeout(() => s.remove(), 2200);
          }
        } catch (e) {}
      }

      function showToast(message, variant = 'emerald') {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const el = document.createElement('div');
        const colors = {
          emerald: 'bg-emerald-600 text-white border-emerald-400',
          amber: 'bg-amber-500 text-slate-950 border-amber-300',
          rose: 'bg-rose-600 text-white border-rose-400'
        };
        el.className = `px-4 py-2.5 rounded-2xl border shadow-xl font-bold text-xs sm:text-sm transition-all duration-300 ${colors[variant] || colors.emerald}`;
        el.textContent = message;
        container.appendChild(el);
        setTimeout(() => {
          el.style.opacity = '0';
          setTimeout(() => el.remove(), 300);
        }, 2600);
      }

      // =======================================================================
      // 5. DETERMINISTIC ARABOPHONE TRANSFER LOGIC (src/utils/transferLogic.ts)
      //    Zero hallucinations: exact syntactic and morphological diagnostics
      // =======================================================================
      function normalizeSentence(str) {
        return String(str || '')
          .trim()
          .replace(/['’‘`]/g, "'")
          .replace(/[.,!?;:]+$/g, '')
          .replace(/\s+/g, ' ')
          .toLowerCase();
      }

      function diagnoseSubmission(userRaw, exercise) {
        const normUser = normalizeSentence(userRaw);
        const candidates = [exercise.target, ...(exercise.acceptedVariants || [])].map(normalizeSentence);

        if (candidates.includes(normUser)) {
          return {
            ok: true,
            tag: null,
            en: 'Spot on! You built the English structure cleanly without carrying over Arabic syntax.',
            ar: 'إجابة ممتازة! لقد بنيت الجملة بالمنطق الإنجليزي الصحيح دون نقل حرفي من العربية.'
          };
        }

        const words = normUser.split(' ').filter(Boolean);

        // 1. Check Missing Copula (am / is / are / was / were)
        const targetNeedsCopula = /\b(am|is|are|was|were)\b/i.test(exercise.target);
        const userHasCopula = /\b(am|is|are|was|were|i'm|it's|they're|we're)\b/i.test(normUser);
        if (targetNeedsCopula && !userHasCopula) {
          return {
            ok: false,
            tag: 'Copula Dropping (حذف فعل الكينونة)',
            en: 'In Arabic, nominal sentences don’t need a verb (أنا طبيب). In English, every sentence needs a verb bridge. Who “am / is / are / were” connecting the subject to the description?',
            ar: 'في العربية الجملة الاسمية لا تحتاج إلى فعل ظاهر، أما في الإنجليزية فلا بد من وجود فعل الكينونة (am / is / are / were) كجسر يربط المبتدأ بالخبر.'
          };
        }

        // 2. Check Possession Interference ("at me" / "am have" / "haven't time")
        if (/\b(at me|with me|i am have|i'm have)\b/i.test(normUser) || (exercise.id.startsWith('p1-l2') && !/\bhave\b/i.test(normUser))) {
          return {
            ok: false,
            tag: 'Possession Transfer (ترجمة عندي حرفياً)',
            en: 'Contrast Arabic “عندي” (at me) with English active ownership: use the action verb “have” directly after the subject (or “do not have” in negation).',
            ar: 'انتبه: كلمة (عندي) في العربية شبه جملة، لكنها في الإنجليزية فعل ملكية صريح (I have / I do not have) ولا نضع قبلها (am) أو (at me).'
          };
        }

        // 3. Check Auxiliary Negation ("he not work" / "he no work" / "does not works")
        if (/\b(he not|she not|i not|no work|does not works|doesn't works)\b/i.test(normUser)) {
          return {
            ok: false,
            tag: 'Auxiliary & Base Verb (الفعل المساعد في النفي)',
            en: 'In English present negation, summon “do not / does not” and strip the “-s” off the main verb (“He does not work”).',
            ar: 'عند نفي المضارع في الإنجليزية نستخدم الفعل المساعد (do not / does not) ويعود الفعل الرئيسي بعده إلى المصدر المجرد بدون (s).'
          };
        }

        // 4. Check Present Perfect vs Simple Past / Present Continuous with Duration
        if (exercise.id.startsWith('p2-l1') && !/\bhave\b/i.test(normUser)) {
          return {
            ok: false,
            tag: 'Present Perfect Bridge (المضارع التام مع لقد/منذ)',
            en: 'Arabic uses “لقد” or present tense with “منذ”, but English needs the Present Perfect bridge (“have sent” / “have been studying”) to link past and present.',
            ar: 'لربط الماضي بالحاضر (مع لقد أو منذ)، تحتاج الإنجليزية إلى جسر المضارع التام (have + التصريف الثالث أو have been + الفعل المضاف له ing).'
          };
        }

        // 5. Check Resumptive Shadow Pronoun ("explained it" in relative clause)
        if (exercise.id === 'p2-l2-e1' && /\b(it|her|him)\b$/i.test(normUser)) {
          return {
            ok: false,
            tag: 'Resumptive Shadow Pronoun (تكرار الضمير العائد)',
            en: 'Watch out for the Arabic returning pronoun (شرحـها)! In English, “that” already carries the object—drop the final “it / her”.',
            ar: 'انتبه للضمير العائد في العربية (شرحـها)! في الإنجليزية كلمة (that) تقوم مقام الضمير العائد، لذا احذف (it) من نهاية الجملة.'
          };
        }

        // 6. Check Conditional "would" in "if" clause or missing past shift
        if (exercise.id === 'p2-l3-e1' && (/\bif i would\b/i.test(normUser) || /\bif i have\b/i.test(normUser))) {
          return {
            ok: false,
            tag: 'Second Conditional Tense Shift (قاعدة لو الشرطية)',
            en: 'After “If” (لو), step the verb into the past simple (“If I had…”), and save “would + verb” for the result half.',
            ar: 'بعد أداة الشرط غير الواقعي (If / لو)، نستخدم الماضي البسيط (If I had)، ونحتفظ بـ (would + المصدر) لجواب الشرط.'
          };
        }

        // 7. Check Preposition Interference (in Friday / since two months)
        if (/\b(in friday|since two months)\b/i.test(normUser)) {
          return {
            ok: false,
            tag: 'Preposition Mapping (حروف الجر)',
            en: 'Watch the preposition transfer: English uses “on” for days (“on Friday”) and “for” with a counted duration (“for two months”).',
            ar: 'انتبه لاختلاف حروف الجر: نستخدم (on) مع أيام الأسبوع (on Friday)، ونستخدم (for) مع المدة الزمنية المحسوبة (for two months).'
          };
        }

        // 8. Check Negative Inversion word order
        if (exercise.id === 'p3-l3-e1' && !/^not only does\b/i.test(normUser)) {
          return {
            ok: false,
            tag: 'Negative Inversion Order (تقديم الفعل المساعد)',
            en: 'When starting with “Not only”, flip the helper verb before the subject just like a question: “Not only does this system save…”',
            ar: 'عند البدء بعبارة الحصر (Not only)، يجب تقديم الفعل المساعد (does) قبل الفاعل (this system) تماماً كصيغة السؤال.'
          };
        }

        // Default targeted structural hint
        return {
          ok: false,
          tag: `${exercise.category}`,
          en: `Check your word order and verb bridge. Compare the Arabic chunks to the English target skeleton (${exercise.target.split(' ').length} words expected).`,
          ar: 'راجع ترتيب الكلمات والجسر الفعلي في الجملة؛ قارن بين أركان الجملة العربية وما يقابلها في الإنجليزية.'
        };
      }

      // =======================================================================
      // 6. VOICE ENGINE (Better Voice Scoring + TTS + SpeechRecognition)
      // =======================================================================
      let availableEnglishVoices = [];

      function scoreVoice(v) {
        let s = 0;
        const name = (v.name || '') + ' ' + (v.voiceURI || '');
        if (/natural|neural|online/i.test(name)) s += 50;
        if (/aria|jenny|guy|ava|andrew|emma|samantha|allison|serena|daniel|karen|google/i.test(name)) s += 20;
        if (/^en[-_]US/i.test(v.lang)) s += 10;
        else if (/^en[-_]GB/i.test(v.lang)) s += 6;
        return s;
      }

      function loadAndScoreVoices() {
        if (!('speechSynthesis' in window)) return;
        const raw = window.speechSynthesis.getVoices() || [];
        const enOnly = raw.filter(v => /^en(-|_|$)/i.test(v.lang));
        enOnly.sort((a, b) => scoreVoice(b) - scoreVoice(a));
        availableEnglishVoices = enOnly;
        renderVoicePicker();
      }

      function getSelectedVoice() {
        if (!availableEnglishVoices.length) return null;
        if (state.preferredVoiceURI) {
          const found = availableEnglishVoices.find(v => v.voiceURI === state.preferredVoiceURI);
          if (found) return found;
        }
        return availableEnglishVoices[0];
      }

      function speakEnglish(text, requestedRate = 1.0) {
        if (!('speechSynthesis' in window)) {
          showToast('Speech synthesis is not supported on this browser.', 'amber');
          return;
        }
        try {
          window.speechSynthesis.cancel();
          const u = new SpeechSynthesisUtterance(text);
          const v = getSelectedVoice();
          if (v) {
            u.voice = v;
            u.lang = v.lang;
          } else {
            u.lang = 'en-US';
          }
          // Specification: Utterance rate = requested rate × 0.92 (Slow button uses 0.6)
          u.rate = Math.max(0.4, Math.min(1.5, requestedRate * 0.92));
          window.speechSynthesis.speak(u);
        } catch (err) {}
      }

      function renderVoicePicker() {
        const select = document.getElementById('voice-picker-select');
        if (!select) return;
        select.innerHTML = '';
        if (!availableEnglishVoices.length) {
          const opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'Default System English Voice';
          select.appendChild(opt);
          return;
        }
        const activeVoice = getSelectedVoice();
        availableEnglishVoices.forEach((v, idx) => {
          const opt = document.createElement('option');
          opt.value = v.voiceURI;
          const badge = scoreVoice(v) >= 50 ? '★ Neural ' : '';
          opt.textContent = `${badge}${v.name} (${v.lang})`;
          if (activeVoice && activeVoice.voiceURI === v.voiceURI) {
            opt.selected = true;
          } else if (!activeVoice && idx === 0) {
            opt.selected = true;
          }
          select.appendChild(opt);
        });
      }

      if ('speechSynthesis' in window) {
        loadAndScoreVoices();
        window.speechSynthesis.onvoiceschanged = loadAndScoreVoices;
      }

